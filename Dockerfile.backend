FROM node:22-alpine

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages ./packages
COPY apps/backend ./apps/backend

RUN pnpm install --frozen-lockfile --filter backend...

EXPOSE 4000

CMD ["sh", "-c", "pnpm --filter backend db:generate && pnpm --filter backend db:migrate && pnpm --filter backend db:seed && pnpm --filter backend exec tsx src/server.ts"]
